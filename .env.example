# ── WMS (source of truth: catalogue, prices, stock, orders) ───────────────────
WMS_API_URL=
WMS_API_KEY=                 # per-store key; identifies this storefront to the WMS
WMS_STORE_ID=                # must match the storeId in WMS webhook envelopes
WMS_WEBHOOK_SECRET=          # HMAC secret for /api/webhooks/wms (order.* and catalog.changed)

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_STORE_NAME=VPR Collection
SESSION_COOKIE_NAME=vpr_session

# ── Storefront DB (Prisma: processed_events only) ─────────────────────────────
DATABASE_URL=                # pooler (6543)
DIRECT_URL=                  # direct (5432) — migrations

# ── Payload CMS — its OWN Supabase project, `payload` schema ──────────────────
PAYLOAD_DATABASE_URL=        # pooler (6543) is fine; runtime + migrations
PAYLOAD_SECRET=              # openssl rand -hex 32
# Dev only, opt-in: push the config schema to the dev DB instead of running migrations.
# Never set in prod; prod runs `npm run deploy:migrate` (prisma migrate deploy + payload migrate).
PAYLOAD_DB_PUSH=false

# ── Media (Google Cloud Storage) ──────────────────────────────────────────────
STOREFRONT_GCS_BUCKET=vpr-storefront-storage
STOREFRONT_GCS_PROJECT_ID=
STOREFRONT_GCS_SERVICE_ACCOUNT_BASE64=   # base64 of the service-account JSON
STOREFRONT_MEDIA_PREFIX=vpr              # files land under vpr/cms/media/
STOREFRONT_GCS_PUBLIC=true               # public-read bucket → direct storage.googleapis.com URLs
# Leave STOREFRONT_GCS_BUCKET empty locally to store uploads in ./media (gitignored).

# ── Email / payments / bot protection / maps ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_ACCEPT_CLIENT_KEY=
NEXT_PUBLIC_ACCEPT_LOGIN_ID=
NEXT_PUBLIC_ACCEPT_SANDBOX=true
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
